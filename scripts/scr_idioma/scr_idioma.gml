/// Texto da chave no idioma atual (ou em inglês, se faltar). Chave sem texto devolve a própria chave.
function tr_texto(_chave) {
    var _lingua = global.textos[$ global.idioma];
    var _txt = (_lingua != undefined) ? _lingua[$ _chave] : undefined;
    if (_txt == undefined) _txt = global.textos.en[$ _chave];
    return (_txt == undefined) ? _chave : _txt;
}

/// @function tr(chave, [args...])
/// @description Devolve o texto da chave no idioma atual, trocando {0}, {1}... pelos argumentos.
/// @example tr("dia_rodape", global.dia)  ->  "Day 1"
function tr(_chave) {
    var _txt = tr_texto(_chave);
    for (var i = 1; i < argument_count; i++) {
        _txt = string_replace_all(_txt, "{" + string(i - 1) + "}", string(argument[i]));
    }
    return _txt;
}

/// @function tr_lista(chave, args)
/// @description Igual a tr(), mas com os argumentos em um array (usado pelas ocorrências salvas).
function tr_lista(_chave, _args) {
    var _txt = tr_texto(_chave);
    for (var i = 0; i < array_length(_args); i++) {
        _txt = string_replace_all(_txt, "{" + string(i) + "}", string(_args[i]));
    }
    return _txt;
}

/// @function idioma_alternar()
/// @description Troca entre inglês e português. Os textos mudam na hora (tr() lê o idioma a cada desenho).
function idioma_alternar() {
    global.idioma = (global.idioma == "en") ? "pt" : "en";
}
